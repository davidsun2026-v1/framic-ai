# CreatorOS Environment Variables Template
# Copy this file to .env.local and fill in with your values
# NEVER commit .env.local to version control

# ========================
# APPLICATION
# ========================

# Environment: development, staging, production
NODE_ENV=development
ENVIRONMENT=development

# Next.js configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CreatorOS
NEXT_PUBLIC_APP_DESCRIPTION=Enterprise AI Creator Platform

# ========================
# SUPABASE (Database & Auth)
# ========================

# Local development defaults (docker-compose provides these)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN1cGFiYXNlIiwicm9sZSI6ImFub24iLCJpYXQiOjE2NDc1MjQ4MzIsImV4cCI6MTk2Nzc2NDgzMn0.HrqOFBFWLxKmj8v2FWEXhBe3JL1T-SYuS5wjqJoK6R0

# Service role key (use with caution - server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN1cGFiYXNlIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTY0NzUyNDgzMiwiZXhwIjoxOTY3NzY0ODMyfQ.OG3MqGYlYxKALWtFxzlPKFqLJpAf_Ue3BJ-Mq7C9cHI

# Database URL for direct connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ========================
# AUTHENTICATION
# ========================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-here
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRY=30d

# Session Configuration
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# OAuth (future)
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_SECRET=

# ========================
# AI PROVIDERS
# ========================

# Replicate API (Image & Video Generation)
REPLICATE_API_TOKEN=
# Get from: https://replicate.com/account/api-tokens

# Model versions (use latest stable)
REPLICATE_IMAGE_MODEL=stable-diffusion-3
REPLICATE_VIDEO_MODEL=zeroscope-v2-576w

# ========================
# PAYMENTS (Paystack)
# ========================

# Paystack Keys (get from https://dashboard.paystack.co/settings/developer)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Optional dedicated webhook signing secret. If unset,
# apps/web/lib/paystack/verify.ts falls back to PAYSTACK_SECRET_KEY, which
# is what Paystack actually signs webhook deliveries with today.
PAYSTACK_WEBHOOK_SECRET=

# For testing, use Paystack test credentials
# Test card: 4084084084084081

# ========================
# FILE STORAGE
# ========================

# AWS S3 Configuration (or MinIO for local dev)
AWS_S3_BUCKET=framic-ai-dev
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# MinIO endpoint (local development)
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true

# CDN Configuration (optional)
NEXT_PUBLIC_CDN_URL=http://localhost:9000/framic-ai-dev

# ========================
# MONITORING & LOGGING
# ========================

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=creatorosprod
SENTRY_PROJECT=framic-ai

# Log Level
LOG_LEVEL=debug
# Options: debug, info, warn, error

# ========================
# EMAIL & NOTIFICATIONS
# ========================

# SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=noreply@creatorosprod.com
FROM_NAME=CreatorOS

# Or Resend
RESEND_API_KEY=

# Or Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ========================
# API CONFIGURATION
# ========================

# Public API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Internal API Secret (for server-to-server communication)
API_SECRET=your-internal-api-secret-32-chars-min

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================
# FEATURE FLAGS
# ========================

# Phase 1 Features
ENABLE_TEXT_TO_IMAGE=true
ENABLE_IMAGE_TO_IMAGE=true
ENABLE_CREDITS_SYSTEM=true
ENABLE_BILLING=true

# Phase 2 Features
ENABLE_TEXT_TO_VIDEO=false
ENABLE_IMAGE_TO_VIDEO=false
ENABLE_VIDEO_EXTENSIONS=false
ENABLE_PROJECT_WORKSPACES=false

# Phase 3 Features
ENABLE_MARKETPLACE=false
ENABLE_TEAM_COLLABORATION=false
ENABLE_SHARED_ASSETS=false

# ========================
# GENERATION COSTS
# ========================

# Credit costs per operation
COST_TEXT_TO_IMAGE=10
COST_IMAGE_TO_IMAGE=15
COST_TEXT_TO_VIDEO=50
COST_IMAGE_TO_VIDEO=40

# ========================
# SUBSCRIPTION PLANS
# ========================

# Monthly credit limits
STARTER_MONTHLY_CREDITS=100
PRO_MONTHLY_CREDITS=500
BUSINESS_MONTHLY_CREDITS=2000

# Monthly prices (in Naira, Paystack uses smallest currency unit)
STARTER_MONTHLY_PRICE=500000  # ₦5,000
PRO_MONTHLY_PRICE=1500000    # ₦15,000
BUSINESS_MONTHLY_PRICE=5000000  # ₦50,000

# ========================
# REDIS (Caching & Sessions)
# ========================

REDIS_URL=redis://localhost:6379
REDIS_DB=0

# ========================
# DATABASE MIGRATIONS
# ========================

# Migration strategy
MIGRATION_AUTO_RUN=true
MIGRATION_LOG_LEVEL=info

# ========================
# DEVELOPMENT TOOLS
# ========================

# Next.js
DEBUG=false
ANALYZE=false

# Turbo
TURBO_TEAM=
TURBO_API=https://api.vercel.com

# ========================
# ANALYTICS & PERFORMANCE
# ========================

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=

# ========================
# SECURITY
# ========================

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Security headers
ENABLE_SECURITY_HEADERS=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block

# ========================
# THIRD-PARTY INTEGRATIONS
# ========================

# Linear (Project Management)
LINEAR_API_KEY=

# Slack (Notifications)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# GitHub (Optional)
GITHUB_TOKEN=

# ========================
# TESTING
# ========================

# Test Database (separate from development)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres_test

# Test Email (optional)
TEST_EMAIL=test@example.com
TEST_PASSWORD=TestPassword123

# ========================
# DEPLOYMENT
# ========================

# Vercel
VERCEL_ENV=development
VERCEL_URL=http://localhost:3000

# ========================
# OPTIONAL / FUTURE
# ========================

# API Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=900

# WebHooks
WEBHOOK_SECRET=your-webhook-secret

# Stripe (if transitioning from Paystack)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ========================
# NOTES
# ========================

# Security Best Practices:
# 1. Never commit .env.local to version control
# 2. Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Use different keys for dev, staging, and production
# 4. Rotate secrets regularly in production
# 5. Store secrets in environment variables, never in code

# For local development:
# - Copy this file: cp .env.example .env.local
# - Edit .env.local with your values
# - .env.local is gitignored and won't be committed

# For production:
# - Use platform secrets (Vercel dashboard, AWS Secrets Manager, etc.)
# - Never paste secrets into this file or anywhere in code
# - Use IAM roles and service accounts where possible
