{
  "name": "Framic AI",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash && ln -sf $HOME/.bun/bin/bun /usr/local/bin/bun && ln -sf $HOME/.bun/bin/bunx /usr/local/bin/bunx && bun install",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Next.js dev server", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"],
      "settings": { "editor.defaultFormatter": "biomejs.biome", "editor.formatOnSave": true }
    }
  },
  "remoteUser": "node"
}
