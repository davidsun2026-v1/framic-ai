{
  "$schema": "https://biomejs.dev/schemas/1.4.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "trailingComma": "es5",
    "semicolons": "always",
    "arrowParentheses": "always",
    "bracketSpacing": true,
    "include": ["**/*.{js,jsx,ts,tsx,json,md}"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "include": ["apps/**/*.{js,jsx,ts,tsx}", "packages/**/*.{js,jsx,ts,tsx}"]
  },
  "organizeImports": {
    "enabled": true,
    "include": ["**/*.{js,jsx,ts,tsx}"]
  }
}
